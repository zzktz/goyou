{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoYou",
  "version": "1.0.20",
  "identifier": "com.zzktz.proxyswitch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run prepare:sing-box && pnpm run build:renderer"
  },
  "app": {
    "windows": [{ "label": "main", "title": "GoYou", "width": 450, "height": 496, "minWidth": 400, "minHeight": 416, "visible": false, "resizable": true, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://proxy.123371.com; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": { "resources/sing-box": "sing-box" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwODVBRDQ4Q0M5QkNBREYKUldUZnlwdk1TSzJGWU9SdmwzZE9OUzlDNVR2ZUVTYjEvaFQvVERnL0NGc0lWSWhSd2JwY3dBck0K",
      "endpoints": [
        "https://proxy.123371.com/v1/app/update/latest?target={target}&arch={arch}&current_version={current_version}"
      ]
    }
  }
}
