APP_NAME=GoYou Management API
JWT_SECRET=replace-with-a-long-random-secret
DB_PATH=/data/goyou.sqlite3
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://tauri.localhost,tauri://localhost
RELAY_HOST=relay.123371.com
RELAY_PORT=24443
RELAY_PORT_START=30000
RELAY_PORT_END=39999
RELAY_METHOD=chacha20-ietf-poly1305
RELAY_PASSWORD=replace-with-the-relay-password
DEFAULT_DAILY_QUOTA_BYTES=500000000
QUOTA_TIMEZONE=Asia/Shanghai
# Required by the trusted relay metering adapter; never expose this to clients.
METERING_TOKEN=replace-with-a-long-random-metering-token
UPDATE_GITHUB_REPOSITORY=zzktz/goyou
# Managed updater files are stored below UPDATE_STORAGE_DIR. Set the public
# URL used in the Tauri manifest when the API is behind a reverse proxy.
UPDATE_STORAGE_DIR=/data/updates
UPDATE_PUBLIC_BASE_URL=https://proxy.123371.com
UPDATE_MAX_ASSET_BYTES=2000000000
ADMIN_EMAIL=admin@example.com
# Prefer ADMIN_PASSWORD_HASH in production. Generate it with the project PasswordHasher.
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_PASSWORD_HASH=
