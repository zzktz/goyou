MANAGEMENT_API_URL=https://proxy.example.com
# Relay ID and the one-time token generated by the management console.
RELAY_ID=default
# Set this to the one-time token generated for the relay. Leave empty only
# while the default relay still uses the legacy shared METERING_TOKEN.
RELAY_TOKEN=
# Kept for compatibility with older single-relay deployments.
METERING_TOKEN=replace-with-the-management-api-metering-token
EGRESS_HOST=127.0.0.1
EGRESS_PORT=19080
RELAY_METHOD=chacha20-ietf-poly1305
SYNC_INTERVAL_SECONDS=5
